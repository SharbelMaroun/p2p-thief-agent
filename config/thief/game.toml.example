# Thief-private local configuration example. Never shared, never signed, never sent.
#
# Section and key names follow the skeleton the book publishes on page 131 and the
# pinned simulator wire reference's own `config/thief/game.toml`, both checked
# 2026-07-31. The real file is `config/game.toml`, which is git-ignored; every value
# below is an inert placeholder.
#
# The split is the point (`ADR-0004`): anything that shapes the *game* lives in the
# shared, signed match JSON, and anything that is nobody else's business -- our port,
# the opponent's address, model choice, credentials -- stays here so it can never
# leak into the agreement.

version = "1.00"

# Book page 131 and the audit of 2026-08-01: the [game] block must carry the group
# identity, the sub-game number, the member list, and the repository URLs — not just
# the two names this example previously held.
[game]
group_name = "private-unconfigured"
group_id = "private-unconfigured"
sub_game_number = 1
members = ["private-unconfigured"]
repos = { cop = "https://example.invalid/cop", thief = "https://example.invalid/thief" }

# The opponent's address is private local knowledge and is read ONLY from here, by
# `shared.private_config.load_opponent_url`. The shared match JSON must carry no URL,
# port, or host at all; `assert_no_network_address` enforces that.
[network]
my_port = 0
opponent_url = "https://opponent.invalid/mcp"
turn_timeout_seconds = 180
poll_interval_seconds = 1
connect_timeout_seconds = 10
retry_interval_seconds = 5
audit_send_timeout_seconds = 60

[strategy]
name = "private-unconfigured"

[llm]
model = "private-unconfigured"
step_deadline_seconds = 30

# Hardware declaration for Step-0 and the pre-game declaration (rule 24, `inst/:1278`).
# The book requires signing TRUE specs -- forging forfeits the computational-fairness
# bonus -- so declare these honestly. `inst/:1278` names them one by one: "Operating
# System (OS), number of processor cores AND their frequency (CPU), RAM capacity,
# presence of a graphics card and video memory (GPU/VRAM)".
#
# Blank or absent => auto-detected where the standard library can answer truthfully.
# `cpu_freq_mhz` cannot be read portably, so you must supply it. On Windows:
#   wmic cpu get MaxClockSpeed
# or read "Base speed" in Task Manager > Performance > CPU (multiply GHz by 1000).
[hardware]
os = ""                # blank => platform.platform()
cpu_type = ""          # blank => platform.processor(); `cpu` still accepted
cpu_freq_mhz = 3600    # REQUIRED -- your CPU's base clock in MHz
cpu_cores = 0          # 0 or absent => os.cpu_count()
ram_gb = 16            # REQUIRED
gpu_model = "none"     # REQUIRED; `gpu` still accepted. "none" is a valid answer
vram_gb = 0            # 0 is valid and means no graphics card

# Where the Gmail send-only token lives (`M7-15`). It MUST be outside this repository:
# `services/credential_location` refuses a path inside the tree, because a credential
# under the repo root is one `git add -A` from being published and rule 39's sanction
# is severe security failure and project failure.
#
# The token must grant `gmail.send` and nothing more -- `assert_send_only` refuses a
# broader grant (rule 30). Mint it with the one-time consent flow in
# `docs/RUNBOOK_reporting_setup.md`; do NOT reuse a token from another project.
[reporting]
credential_path = "C:/path/outside/this/repo/token_p2p_send.json"

[email]
recipient = "private-unconfigured"
mode = "draft"

# Credentials, tunnel tokens, API keys, signing secrets, and per-turn commitment
# nonces belong in an ignored .env or credential store -- never in this example,
# never in this file, and never in any shared JSON.
