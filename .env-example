# Optional local integration placeholders. The M1 scaffold does not read these values.
# Copy this file to .env only after the corresponding integration is approved.
#
# OPTIONAL_EXTERNAL_API_KEY=dummy-provider-key
# OPTIONAL_TUNNEL_CREDENTIAL=dummy-tunnel-credential
# OPTIONAL_EMAIL_CREDENTIALS_PATH=credentials.example.json
#
# Never place a real key, token, OAuth secret, tunnel credential, email credential,
# or commit-reveal nonce in this file or in Git.
